ocio_profile_version: 1
roles:
  scene_linear: Linear
  reference: Linear
  default: Linear
  default_byte: sRGB
  default_float: Linear
  data: Linear
  color_picking: sRGB
  texture_paint: sRGB
  compositing_log: Linear
displays:
  sRGB:
    - !<View> {name: Standard, colorspace: sRGB}
    - !<View> {name: Raw, colorspace: Linear}
active_displays: [sRGB]
active_views: [Standard, Raw]
colorspaces:
  - !<ColorSpace>
    name: Linear
    family: linear
    equalitygroup: linear
    bitdepth: 32f
    isdata: false
    allocation: uniform
  - !<ColorSpace>
    name: sRGB
    family: display
    equalitygroup: srgb
    bitdepth: 8ui
    isdata: false
    allocation: uniform
    to_reference: !<ExponentTransform> {value: [2.2, 2.2, 2.2, 1]}
